# ========================================
# 中心世界配置示例
# ========================================

# 情况1：你作为中心世界（让别人连接到你）
# ------------------------------------------------
# 复制以下内容到你的 .env 文件：

WORLD_NAME=中心世界
WORLD_URL=http://你的公网IP:3002

# 注意：
# - WORLD_URL 必须是公网可访问的地址
# - 不需要配置 CENTRAL_WORLD_URL
# - 启动后，将 WORLD_URL 分享给其他人


# ========================================
# 客户端配置示例
# ========================================

# 情况2：连接到其他人的中心世界
# ------------------------------------------------
# 复制以下内容到你的 .env 文件：

WORLD_NAME=我的虚拟世界
WORLD_URL=http://localhost:3002
CENTRAL_WORLD_URL=http://123.45.67.89:3002
AUTO_CONNECT_CENTRAL=true

# 注意：
# - 将 CENTRAL_WORLD_URL 改为实际的中心世界地址
# - AUTO_CONNECT_CENTRAL=true 表示启动时自动连接
# - 如果本地测试，WORLD_URL 用 localhost
# - 如果要让别人连接你，WORLD_URL 用公网IP


# ========================================
# 快速开始
# ========================================

# 1. 编辑 .env 文件，添加上面的配置
# 2. 运行: npm start
# 3. 查看日志，确认是否连接成功
# 4. 登录游戏，点击"🌍 世界传送门"查看连接的世界


# ========================================
# 示例网络拓扑
# ========================================

# 星型网络：
#         中心世界 (123.45.67.89:3002)
#        /    |    \
#       /     |     \
#    世界A  世界B  世界C
#    (本地) (本地) (本地)

# 配置：
# - 中心世界：只需配置 WORLD_URL
# - 世界A/B/C：配置 CENTRAL_WORLD_URL=http://123.45.67.89:3002
