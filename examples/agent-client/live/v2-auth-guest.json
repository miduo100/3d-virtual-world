                    }
                  }
                }
              },
              "responses": {
                "200": {
                  "description": "JWT issued",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "success": {
                            "type": "boolean"
                          },
                          "token": {
                            "type": "string"
                          },
                          "tokenType": {
                            "type": "string",
                            "example": "Bearer"
                          },
                          "expiresIn": {
                            "type": "integer",
                            "example": 900
                          },
                          "expiresAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "agent": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
