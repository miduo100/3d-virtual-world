              "description": "Rate-limited: 10/min per IP. Refused when agent_enabled=false.",
              "security": [
                {
                  "AgentApiKey": []
                }
              ],
              "requestBody": {
                "required": false,
                "content": {
                  "application/json": {
                    "schema": {
