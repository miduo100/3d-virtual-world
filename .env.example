# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=virtual_world
DB_USER=postgres
DB_PASSWORD=your_password

# 服务器配置
PORT=3002
WS_PORT=3001
JWT_SECRET=your_secret_key_change_this_in_production

# Node环境
NODE_ENV=development

# 管理员JWT密钥
ADMIN_JWT_SECRET=your_admin_secret_key_change_this_in_production

# 腾讯云混元3D配置
TENCENT_SECRET_ID=your_secret_id
TENCENT_SECRET_KEY=your_secret_key
TENCENT_REGION=ap-guangzhou

# 联邦系统配置
WORLD_NAME=我的虚拟世界
WORLD_URL=http://localhost:3002

# 中心世界配置（自动连接到主世界）
CENTRAL_WORLD_URL=https://miduo100.com
AUTO_CONNECT_CENTRAL=true

# ===== AI场景生成配置 =====
# 以下API Key至少配置一个，否则将使用默认场景模板

# 通义千问 (推荐，质量高)
# 注册地址: https://dashscope.console.aliyun.com
# 价格: ¥0.04/1K tokens
# 免费额度: 100万tokens
QWEN_API_KEY=

# 豆包 (推荐，性价比最高)
# 注册地址: https://console.volcengine.com/ark
# 价格: ¥0.008/1K tokens
# 免费额度: ¥10-20
DOUBAO_API_KEY=

# 腾讯混元 (可选，可复用上面的混元3D配置)
# 已配置则自动启用
HUNYUAN_SECRET_ID=
HUNYUAN_SECRET_KEY=
