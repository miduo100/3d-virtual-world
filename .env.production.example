# ============================================
# 生产环境配置文件
# ============================================
# 复制此文件为 .env.production 并修改配置值
# cp .env.production.example .env.production
# ============================================

# 数据库配置（与 docker-compose.yml 中的 PostgreSQL 容器一致）
DB_PORT=5432
DB_NAME=virtual_world
DB_USER=virtual_world
DB_PASSWORD=请修改为强密码_至少16位随机字符

# 服务器配置
PORT=3002
WS_PORT=3001

# JWT 密钥（必须修改！用于登录 token 加密）
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=请修改为随机密钥_64位十六进制字符
ADMIN_JWT_SECRET=请修改为另一个随机密钥_64位十六进制字符

# Node 环境
NODE_ENV=production

# 世界配置
WORLD_NAME=我的虚拟世界
# 部署后替换为你的实际域名/IP
WORLD_URL=https://your-domain.com

# 中心世界配置（新世界部署后自动连接到主世界）
# 不配置则默认连接 https://miduo100.com
CENTRAL_WORLD_URL=https://miduo100.com
AUTO_CONNECT_CENTRAL=true

# ====== AI 功能配置（可选，不配不影响核心功能） ======

# 通义千问 API Key
QWEN_API_KEY=

# 豆包 API Key
DOUBAO_API_KEY=

# 腾讯云混元 3D（可选，用于 AI 生成 3D 模型）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou

# Tripo AI（可选，另一个 AI 3D 模型生成服务）
TRIPO_API_KEY=
